{
  "name": "bililiveagent",
  "version": "0.1.0",
  "private": true,
  "description": "BiliLiveAgent：B 站直播间弹幕智能体，读取弹幕与互动事件，由 DeepSeek 驱动全自动安全互动",
  "main": "dist/main/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cloviah/BiliLiveAgent.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.446.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
